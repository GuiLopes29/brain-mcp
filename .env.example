# Embeddings run in-process via Transformers.js — no separate service, nothing to configure.
# Override only if you want a different Hugging Face model id (must also match EMBEDDING_DIM in sqlite.ts).
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Ollama Cloud (classifier — get key at ollama.com)
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=qwen3-coder:480b-cloud
# Comma-separated, tried in order if the primary model fails (HTTP error, timeout, bad JSON).
OLLAMA_FALLBACK_MODELS=minimax-m2.1:cloud
CLASSIFIER_TIMEOUT_MS=60000
CLASSIFIER_ENABLED=true
# Language of AI-generated content (title/content/directive/reasoning). Defaults
# to English when unset. Set to "pt-BR" (or any other language name) to keep an
# existing knowledge base's language consistent — this only affects newly
# generated text, it doesn't translate what's already stored.
CLASSIFIER_LANGUAGE=en

# SQLite
SQLITE_PATH=./data/brain.db

# HTTP Bridge (UI API)
API_PORT=3456

# Backup (pnpm backup / auto-backup on API start + every 24h)
# BRAIN_AUTO_BACKUP=false disables the automatic schedule entirely.
BRAIN_AUTO_BACKUP=true
# Comma-separated project names to EXCLUDE from backups/brain-export.json before
# it's committed. Use this if the Brain is shared across a public repo AND private/
# client repos — e.g. BACKUP_EXCLUDE_PROJECTS=client-project-a,client-project-b
# keeps their knowledge out of the public export. Empty (default) exports everything.
BACKUP_EXCLUDE_PROJECTS=

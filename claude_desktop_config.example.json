{
  "mcpServers": {
    "brain-mcp": {
      "command": "node",
      "args": [
        "<ABSOLUTE_PATH_TO_REPO>\\packages\\mcp-server\\dist\\index.js"
      ],
      "env": {
        "CHROMA_URL": "http://localhost:8000",
        "CHROMA_COLLECTION": "brain_knowledge",
        "OLLAMA_URL": "http://localhost:11434",
        "OLLAMA_MODEL": "nomic-embed-text"
      }
    }
  }
}
